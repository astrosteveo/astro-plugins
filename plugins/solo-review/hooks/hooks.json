{
  "description": "solo-review workflow hooks. They act only in projects with a .review/ directory: give Claude the branch and commit-as-you-work rules at session start, block file edits on the default branch (branch: require), and block `git push` while any finding is open (gate: push). The module (register.tsx) shows the review state and serves the ledger tools.",
  "modules": ["./register.tsx"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/ledger.py\" branch-guard",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/ledger.py\" gate",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/ledger.py\" session-context",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
